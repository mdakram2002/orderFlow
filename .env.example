NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_SECONDS=3600
ADMIN_EMAILS=

POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_dev_only
USER_DATABASE_URL=postgresql+psycopg://orderflow:orderflow_dev_only@postgres:5432/user_db
ORDER_DATABASE_URL=postgresql+psycopg://orderflow:orderflow_dev_only@postgres:5432/order_db
PAYMENT_DATABASE_URL=postgresql://orderflow:orderflow_dev_only@postgres:5432/payment_db

MONGODB_URI=mongodb://mongo:27017/orderflow
REDIS_URL=redis://redis:6379/0

GATEWAY_PORT=3000
GATEWAY_HOST_PORT=30000
DOWNSTREAM_TIMEOUT_MS=15000
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
USER_SERVICE_PORT=8001
USER_GRPC_TARGET=user-service:50051
PRODUCT_SERVICE_PORT=8002
PRODUCT_GRPC_TARGET=product-service:50052
ORDER_SERVICE_PORT=8003
ORDER_GRPC_TARGET=order-service:50053
PAYMENT_SERVICE_PORT=8004
PAYMENT_GRPC_TARGET=payment-service:50054
NOTIFICATION_SERVICE_PORT=8005
PAYMENT_MODE=success
SEED_DEMO_DATA=true
PRODUCT_CACHE_TTL_SECONDS=300
STREAM_NAME=order-events
CONSUMER_GROUP=notification-workers
CONSUMER_NAME=notification-worker-1
GRPC_TIMEOUT_SECONDS=2
INVENTORY_RESERVATION_TTL_SECONDS=900

FRONTEND_HOST_PORT=30001
PLAYWRIGHT_BASE_URL=http://localhost:30001
API_GATEWAY_URL=http://localhost:30000
GHCR_OWNER=your-github-owner
